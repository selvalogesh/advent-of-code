{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AoC: TypeScript day",
      "request": "launch",
      "cwd": "${workspaceFolder}/${input:year}/typescript",
      "runtimeArgs": ["run-script", "start", "${input:day}"],
      "runtimeExecutable": "pnpm",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "type": "node"
    }
  ],
  "inputs": [
    {
      "id": "year",
      "type": "promptString",
      "description": "AoC year (folder name)",
      "default": "2024"
    },
    {
      "id": "day",
      "type": "promptString",
      "description": "Day to run (dayXX)",
      "default": "day06"
    }
  ]
}
